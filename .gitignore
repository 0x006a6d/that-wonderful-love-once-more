# Godot 4
.godot/
*.translation
export_presets.cfg

# ビルド成果物
build/
export/

# 再配布不可アセット (ライセンス上リポジトリに含めない。tools/fetch_assets.sh と README の開発セットアップ参照)
# VRM: 公式 IP 資産の再ホスティング回避
assets/vrm/*.vrm
# Mixamo (Adobe) 由来 FBX: 素材ファイル単体の再配布不可
assets/motions/mixamo_*.fbx
# キャラクター FBX と、インポータが同フォルダへ展開する埋め込みテクスチャ
assets/characters/mixamo_*.fbx
assets/characters/mixamo_*.png
# Mixamo キャラを素材のまま並べた QC 画像。ゲーム画面ではないので公開しない
docs/img/qc_*.png
docs/img/qc_*.png.import

# 許諾記録はローカル管理、公開しない
docs/permissions.md

# 日付入りの進行管理と個人的な作業メモはローカル管理。公開リポジトリに置く意味が無い
docs/tasks.md
docs/tasks-full.md
はじめ方.md

# OS
Thumbs.db
.DS_Store
